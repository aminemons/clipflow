# Copy this file to /opt/clipflow/.env and chmod 600 before starting compose.
# Keep this file private. The example contains no usable credentials.

CLIPFLOW_DOMAIN=studio.example.com
CLIPFLOW_PUBLIC_ORIGIN=https://studio.example.com
CLIPFLOW_WORKER_ORIGIN=https://worker.example.com

CLIPFLOW_MODE=hosted
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
CLIPFLOW_OWNER_ID=replace-with-supabase-auth-user-id
CLIPFLOW_SESSION_TTL_SECONDS=28800

# Optional provider settings. Leave blank to use local processing.
CLIPFLOW_TRANSCRIPTION_PROVIDER=local
CLIPFLOW_TRANSCRIPTION_QUALITY=balanced
CLIPFLOW_HIGGSFIELD_ENABLED=false
GROQ_API_KEY=
HF_API_KEY=
HF_API_SECRET=
