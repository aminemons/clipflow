# No paid key is required for importing, editing, tracking, captions, or exporting.
# Copy this file to .env and restart Clipflow after changing settings.

# local = free on-device Whisper; groq = hosted speech recognition using your key.
CLIPFLOW_TRANSCRIPTION_PROVIDER=local
# Quality maps to tiny (fast), small (balanced), or large-v3 (accurate).
CLIPFLOW_TRANSCRIPTION_QUALITY=balanced
# Optional explicit local model override. Leave blank to use the quality map.
CLIPFLOW_WHISPER_MODEL=
CLIPFLOW_WHISPER_DEVICE=cpu
CLIPFLOW_WHISPER_COMPUTE=int8
# Language: auto, ar, fr, or en. Algerian dialect sets ar automatically.
CLIPFLOW_LANGUAGE=auto
CLIPFLOW_DIALECT=none
# Optional domain/context hint, max 500 characters.
CLIPFLOW_TRANSCRIPTION_PROMPT=
# Optional: a drive with several GB free for source videos, renders, and models.
# CLIPFLOW_DATA=D:/Clipflow/data
# CLIPFLOW_MODEL_CACHE=D:/Clipflow/models

# Only needed when CLIPFLOW_TRANSCRIPTION_PROVIDER=groq.
# Get a key at https://console.groq.com/keys. Provider account limits may apply.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional Higgsfield generation. Uses your provider account/credits.
HF_API_KEY=
HF_API_SECRET=

# Smart highlights: local ranking is free; groq uses the key above.
CLIPFLOW_HIGHLIGHT_PROVIDER=local
GROQ_HIGHLIGHT_MODEL=llama-3.3-70b-versatile
# Optional transcript highlight ranking. Select a provider in Settings.
# Ollama runs locally after you install it and download the selected model.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
OLLAMA_TEXT_MODEL=qwen3:8b
# Provider Settings in the editor can change these values without restarting.
CLIPFLOW_HIGGSFIELD_ENABLED=true

# Optional private hosted workspace. Local mode needs none of these values.
# One backend process + persistent volume per owner; no shared multiuser workspace.
CLIPFLOW_MODE=local
CLIPFLOW_PUBLIC_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CLIPFLOW_OWNER_ID=
CLIPFLOW_SESSION_TTL_SECONDS=3600
# Store this file on the persistent volume in a hosted container.
# CLIPFLOW_SETTINGS_FILE=/app/data/settings.env
# Generate Vercel rewrites with scripts/generate-vercel-config.mjs after setting
# CLIPFLOW_WORKER_ORIGIN to the real HTTPS worker; do not use localhost.
CLIPFLOW_WORKER_ORIGIN=
