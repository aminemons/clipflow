{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://clipflow-aminemons.swedencentral.cloudapp.azure.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://clipflow-aminemons.swedencentral.cloudapp.azure.com/media/:path*"
    },
    {
      "source": "/((?!api/|media/|assets/|fonts/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
